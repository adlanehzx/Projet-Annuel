# Database
DATABASE_URL="postgresql://user:password@localhost:5432/movie_tracker"

# JWT
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRY="7d"

# OAuth Google - le backend vérifie l'id_token émis par Google Identity
# Services côté client, il n'a donc besoin que du Client ID (public), pas
# d'un client secret.
GOOGLE_CLIENT_ID="your-google-client-id"

# OAuth GitHub - le backend échange le code d'autorisation contre un
# access_token, le client secret ne doit jamais être exposé au frontend.
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_REDIRECT_URI="http://localhost:3000/auth/callback/github"

# Server
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
