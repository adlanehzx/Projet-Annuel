// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  username String @unique
  password String?
  isPublic Boolean @default(false)
  bio String?
  avatar String?
  
  // 2FA
  totpSecret String?
  totpEnabled Boolean @default(false)
  
  // OAuth
  googleId String? @unique
  githubId String? @unique
  oauthProviders OAuthProvider[]
  
  watchlist Watchlist[]
  reviews Review[]
  collections Collection[]
  lists List[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OAuthProvider {
  id    Int     @id @default(autoincrement())
  provider String // "google", "github"
  providerUserId String
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@unique([provider, userId])
  @@index([userId])
}

// Watchlist avec status
model Watchlist {
  id    Int     @id @default(autoincrement())
  tmdbId Int @unique
  title String
  posterPath String?
  status WatchStatus @default(TO_WATCH) // TO_WATCH, WATCHING, COMPLETED
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews Review[]
  inCollections CollectionItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tmdbId])
  @@index([userId])
}

enum WatchStatus {
  TO_WATCH
  WATCHING
  COMPLETED
}

// Reviews & Notes
model Review {
  id    Int     @id @default(autoincrement())
  rating Int @default(0) // 0-10
  comment String?
  userId Int
  watchlistId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, watchlistId])
  @@index([userId])
  @@index([watchlistId])
}

// Collections personnalisées (listes thématiques)
model Collection {
  id    Int     @id @default(autoincrement())
  name String
  description String?
  isPublic Boolean @default(false)
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model CollectionItem {
  id    Int     @id @default(autoincrement())
  order Int @default(0)
  collectionId Int
  watchlistId Int
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([collectionId, watchlistId])
  @@index([collectionId])
  @@index([watchlistId])
}

model List {
  id          Int        @id @default(autoincrement())
  userId      Int        @map("user_id")
  title       String
  description String?
  isPublic    Boolean    @default(false) @map("is_public")
  createdAt   DateTime   @default(now()) @map("created_at")
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  animes      ListAnime[]

  @@index([userId])
  @@index([isPublic])
  @@index([createdAt])
  @@map("lists")
}

model ListAnime {
  id       Int   @id @default(autoincrement())
  listId   Int   @map("list_id")
  animeId  Int   @map("anime_id")
  position Int
  list     List  @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, animeId])
  @@index([listId])
  @@index([animeId])
  @@index([listId, position])
  @@map("list_animes")
}
