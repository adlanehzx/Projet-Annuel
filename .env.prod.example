# Copier ce fichier en ".env" sur le serveur (jamais commité, déjà dans .gitignore)
# à côté de docker-compose.prod.yml, avec les vraies valeurs de prod.

DB_PASSWORD=change-moi
JWT_SECRET=change-moi-avec-une-vraie-valeur-aleatoire-longue

# OAuth Google (Google Cloud Console -> Identifiants)
# Origine JS autorisée à ajouter: https://hankotrack.com
GOOGLE_CLIENT_ID=

# OAuth GitHub (github.com/settings/developers -> OAuth Apps)
# Authorization callback URL à ajouter: https://hankotrack.com/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
